SIM ?= icarus
TOPLEVEL_LANG = verilog
VERILOG_SOURCES = \
	$(CURDIR)/../src/v3_timebase.v \
	$(CURDIR)/../src/v3_pin_cell.v \
	$(CURDIR)/../src/v3_input_filter.v \
	$(CURDIR)/../src/v3_progmem.v \
	$(CURDIR)/../src/v3_crc.v \
	$(CURDIR)/../src/v3_fifo.v \
	$(CURDIR)/../src/v3_engine.v \
	$(CURDIR)/../src/v3_host_spi.v \
	$(CURDIR)/../src/v3_capture.v \
	$(CURDIR)/../src/v3_project.v
VERILOG_INCLUDE_DIRS = $(CURDIR)/../src
COMPILE_ARGS += -I$(CURDIR)/../src
TOPLEVEL = tt_um_mcranny_protocol_emulator_v3
COCOTB_TEST_MODULES = v3.test_spi
MODULE = $(COCOTB_TEST_MODULES)
SIM_BUILD = sim_build/v3spi
COCOTB_RESULTS_FILE = results_v3spi.xml
export PYTHONPATH := $(CURDIR):$(CURDIR)/../host:$(PYTHONPATH)
include $(shell cocotb-config --makefiles)/Makefile.sim
