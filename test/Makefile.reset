# Four-state startup/reset audit, independent of the ordinary pin suite.
override SIM := icarus
TOPLEVEL_LANG = verilog
TOPLEVEL = reset_tb
VERSION ?= 2
ifeq ($(VERSION),1)
DUT_TOP = tt_um_mcranny_protocol_emulator
else ifeq ($(VERSION),2)
DUT_TOP = tt_um_mcranny_protocol_emulator_v2
else
$(error VERSION must be 1 or 2)
endif
COCOTB_TEST_MODULES = v$(VERSION).test_reset
COMPILE_ARGS += -DDUT_TOP=$(DUT_TOP)
ifeq ($(GATES),yes)
ifndef PDK_ROOT
$(error PDK_ROOT is required for gate-level reset simulation)
endif
ifndef GATE_LEVEL_NETLIST
$(error GATE_LEVEL_NETLIST is required for gate-level reset simulation)
endif
COMPILE_ARGS += -DFUNCTIONAL -DSIM
VERILOG_SOURCES = $(PDK_ROOT)/ihp-sg13cmos5l/libs.ref/sg13cmos5l_stdcell/verilog/sg13cmos5l_udp.v
VERILOG_SOURCES += $(PDK_ROOT)/ihp-sg13cmos5l/libs.ref/sg13cmos5l_stdcell/verilog/sg13cmos5l_stdcell.v
VERILOG_SOURCES += $(GATE_LEVEL_NETLIST)
else
VERILOG_SOURCES = $(sort $(wildcard $(CURDIR)/../src/*.v))
endif
VERILOG_SOURCES += $(CURDIR)/reset_tb.v
SIM_BUILD = sim_build/reset-v$(VERSION)
COCOTB_RESULTS_FILE = results_reset_v$(VERSION).xml
export COCOTB_RESOLVE_X := error
export PYTHONPATH := $(CURDIR):$(CURDIR)/../host:$(PYTHONPATH)
include $(shell cocotb-config --makefiles)/Makefile.sim
