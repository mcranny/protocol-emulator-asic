SIM ?= icarus
TOPLEVEL_LANG = verilog
VERILOG_SOURCES = $(CURDIR)/../src/v3_host_spi.v
TOPLEVEL = v3_host_spi
# MODULE is the cocotb 1.x name; COCOTB_TEST_MODULES is the cocotb 2.x name.
MODULE = v3.test_host_spi
COCOTB_TEST_MODULES = v3.test_host_spi
SIM_BUILD = sim_build/v3host
COCOTB_RESULTS_FILE = results_v3_host.xml
export PYTHONPATH := $(CURDIR):$(CURDIR)/../host:$(PYTHONPATH)
include $(shell cocotb-config --makefiles)/Makefile.sim
