SIM ?= icarus
WAVES ?= 1
TOPLEVEL_LANG = verilog
VERILOG_SOURCES = $(CURDIR)/../src/engine.v
TOPLEVEL = protocol_engine
COCOTB_TEST_MODULES = v1.test_engine
