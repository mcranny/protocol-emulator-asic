SIM ?= icarus
TOPLEVEL_LANG = verilog
VERILOG_SOURCES = \
	$(CURDIR)/../src/v3_fifo.v \
	$(CURDIR)/support/v3_fifo_tb.v
TOPLEVEL = v3_fifo_tb
COCOTB_TEST_MODULES = v3.test_fifo
# cocotb 1.9.x, as installed in WSL, reads MODULE instead.
MODULE = v3.test_fifo
SIM_BUILD = sim_build/v3fifo
COCOTB_RESULTS_FILE = results_v3fifo.xml
export PYTHONPATH := $(CURDIR):$(CURDIR)/../host:$(PYTHONPATH)
include $(shell cocotb-config --makefiles)/Makefile.sim
